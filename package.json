{
  "name": "self-heal-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "probe:harness": "node scripts/harness-probe.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:heal": "node scripts/demo.mjs --heal",
    "demo:journal": "node scripts/demo.mjs --heal --twice"
  },
  "devDependencies": {
    "@self-heal/core": "workspace:*",
    "@self-heal/detector-command": "workspace:*",
    "@self-heal/detector-contract": "workspace:*",
    "@self-heal/fixer-noop": "workspace:*",
    "@self-heal/fixer-harness": "workspace:*",
    "@self-heal/journal": "workspace:*",
    "@self-heal/testkit": "workspace:*",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
