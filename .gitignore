node_modules/
dist/
*.tsbuildinfo

# Evidence artifacts stay on disk, never in git (ARCHITECTURE.md §2)
.self-heal/
*.sqlite
*.sqlite-journal

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Env
.env
.env.*
!.env.example
# Design docs stay local; the README is the only published markdown.
*.md
!README.md

# Release artifacts. The per-package README and LICENSE are copies of the root
# ones, written by scripts/prepare-release.mjs so npm has something to show —
# generated rather than committed, so the two can never drift apart.
packages/**/README.md
packages/**/LICENSE
*.tgz
