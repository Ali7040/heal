{
  "name": "self-heal",
  "version": "0.1.0",
  "description": "A closed-loop agent that detects regressions deterministically, proposes a fix through your installed agent harness, and verifies it by re-running the original detection.",
  "keywords": [
    "agent",
    "self-healing",
    "regression",
    "visual-regression",
    "contract-testing",
    "cli"
  ],
  "license": "MIT",
  "author": "Ali Haider",
  "homepage": "https://github.com/Ali7040/heal#readme",
  "bugs": "https://github.com/Ali7040/heal/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ali7040/heal.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "self-heal": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@self-heal/core": "workspace:*",
    "@self-heal/detector-command": "workspace:*",
    "@self-heal/detector-contract": "workspace:*",
    "@self-heal/detector-visual": "workspace:*",
    "@self-heal/fixer-harness": "workspace:*",
    "@self-heal/fixer-noop": "workspace:*",
    "@self-heal/journal": "workspace:*"
  }
}
