  "description": "Adapter that drives the user's installed agent harness in a sandbox and captures the resulting patch from git.",
  "license": "MIT",
  "author": "Ali Haider",
  "homepage": "https://github.com/Ali7040/heal#readme",
  "bugs": "https://github.com/Ali7040/heal/issues",
  "repository": {
    "type": "git",
